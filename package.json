{
  "name": "lobbylive",
  "version": "1.0.0",
  "private": true,
  "description": "Salas multiplayer persistentes, JWT e chat em tempo real com NestJS e Socket.IO",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:pending": "mikro-orm migration:pending",
    "migration:create": "mikro-orm migration:create",
    "migration:up:prod": "MIKRO_ORM_CLI_CONFIG=./dist/mikro-orm.config.js mikro-orm migration:up",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "client": "node scripts/client.mjs",
    "env:init": "node scripts/init-env.mjs"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ],
    "preferTs": true
  },
  "dependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestjs/websockets": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "socket.io": "^4.8.0",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "socket.io-client": "^4.8.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0"
  }
}
